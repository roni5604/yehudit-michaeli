  "steps": [
    { "group": "הכנה מוקדמת", "items": [
      { "text": "משרים את גרגירי החומוס בכמות גדולה של מים למשך כל הלילה.", "timerMin": null },
      { "text": "משרים את העדשים והחיטה כחצי שעה, בזמן שמכינים את שאר המרכיבים.", "timerMin": 30 }
    ] },
    { "group": "הרכבת החמין", "items": [
      { "text": "בסיר גדול שאפשר להעביר לתנור מטגנים את הבצל בשמן עד להזהבה.", "timerMin": null },
      { "text": "מקלפים את כל הירקות. לקילוף הסלק מומלץ לבשל אותו בישול קצר בהרבה מים, או במיקרוגל, עד שהקליפה יורדת בקלות. אפשר גם לקנות סלק קלוף ארוז בוואקום. אם רוצים, אפשר לחצות את הירקות.", "timerMin": null },
      { "text": "מניחים את הירקות על הבצל המוזהב ומפזרים מעליהם את שיני השום.", "timerMin": null },
      { "text": "שוטפים את החומוס, העדשים והחיטה ומסננים. מפזרים אותם על הירקות שבסיר.", "timerMin": null },
      { "text": "מתבלים היטב במלח, פלפל, פפריקה, כמון וכוסברה.", "timerMin": null },
      { "text": "יוצקים מים עד שהמרכיבים מכוסים לגמרי ועוד 2 ס״מ מעליהם, ולבסוף יוצקים את הסילאן.", "timerMin": null }
    ] },
    { "group": "בישול", "items": [
      { "text": "מביאים את הסיר לרתיחה ומבשלים כחצי שעה.", "timerMin": 30 },
      { "text": "מכסים בנייר אפייה ועליו מכסה, מעבירים לתנור ואופים שעה ב-180 מעלות.", "timerMin": 60 },
      { "text": "מקטינים את החום לכ-100 מעלות וממשיכים לבשל בחום נמוך, כמו כל חמין.", "timerMin": null },
      { "text": "בודקים מפעם לפעם ומוסיפים מים רותחים, כדי שהחמין לא יתייבש.", "timerMin": null }
    ] }
