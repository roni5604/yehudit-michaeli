  "steps": [
    {
      "group": "ניקוי הכבד",
      "items": [
        {
          "text": "מנקים את כבד האווז מנימי דם, משאריות מרה ומקרומים.",
          "timerMin": null
        },
        {
          "text": "שומרים את הכבדים הנקיים בבאן-מארי קרח. בכל פעם שכבד אחד יוצא מהמקרר לניקוי, מחזירים למקרר את הכבד הנקי שבבאן-מארי.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "השרייה",
      "items": [
        {
          "text": "משרים את הכבד (ל-1 ק״ג כבד נקי) במי הקרח, הסוכר, המלח והברנדי למשך שעתיים עד 24 שעות.",
          "timerMin": 120
        },
        {
          "text": "מסננים היטב את הכבד מהנוזלים, סוחטים ומוציאים שאריות ורידים אם נותרו.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "תיבול והכנת הכלי",
      "items": [
        {
          "text": "מערבבים אל הכבד המסונן והסחוט את חומרי התיבול, על כל 1 ק״ג כבד.",
          "timerMin": null
        },
        {
          "text": "מרטיבים את כלי הטרין ומצמידים אליו ניילון נצמד עם מגבת, כדי שהניילון יהודק אליו עד המקסימום.",
          "timerMin": null
        },
        {
          "text": "מכניסים את הכבד לכלי הטרין (בכל כלי דוחסים כ-1.8 עד 2 ק״ג כבד) ומהדקים עם פלטה.",
          "timerMin": null
        },
        {
          "text": "מקפלים את הניילון ומהדקים עם כלי טרין נוסף.",
          "timerMin": null
        },
        {
          "text": "מכינים משקולת: לבנה ופיסת קרמיקה בגודל המתאים לכלי הטרין.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "אפייה",
      "items": [
        {
          "text": "מניחים בתחתית הגסטרונום נייר פילוש, כדי למנוע מגע ישיר, וממלאים אותו במים חמים עד רבע מגובה הטרין.",
          "timerMin": null
        },
        {
          "text": "אופים בתנור ב-140 מעלות במשך 50 דקות.",
          "timerMin": 50
        },
        {
          "text": "מוציאים את הטרין מהגסטרונום, מניחים עליו קרמיקה ומעליה לבנה, ומוודאים שהמשטח מאוזן.",
          "timerMin": null
        },
        {
          "text": "מצננים מעט ומכניסים למקרר.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "הגשה",
      "items": [
        {
          "text": "מחממים פרוסת בריוש בתנור.",
          "timerMin": null
        },
        {
          "text": "פורסים פרוסה מהטרין בסכין טרין חמה.",
          "timerMin": null
        },
        {
          "text": "מעטרים את קרש הקרמיקה ברוטב יין ותאנים ומקשטים בעלה דפנה.",
          "timerMin": null
        },
        {
          "text": "מפזרים מעל הטרין מלח גס ופלפל שחור, ומוסיפים שזיף כבוש או דבלה ביין.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "דבלים ביין",
      "items": [
        {
          "text": "מביאים לרתיחה איטית בסיר יין אדום יבש וסוכר ביחס 1:1, עם מקל קינמון.",
          "timerMin": null
        },
        {
          "text": "מכסים בנוזל את הדבלים (ללא העוקץ) ומבשלים על להבה נמוכה, עד שהנוזל הופך לסירופ והדבלים תפוחים.",
          "timerMin": null
