  "steps": [
    {
      "group": null,
      "items": [
        {
          "text": "אופים את תפוחי האדמה בשלמותם ומרוקנים מהקליפה בעודם חמים.",
          "timerMin": null
        },
        {
          "text": "מועכים ומוסיפים קמח, רק כמה שצריך (כמה שפחות, כדי שהכופתאות יהיו קלות יותר), ולשים לתערובת אחידה.",
          "timerMin": null
        },
        {
          "text": "מוסיפים את הביצים אחת אחת, 50 גרם חמאה רכה ומלח.",
          "timerMin": null
        },
        {
          "text": "ממשיכים ללוש עד לקבלת בצק אחיד ורך.",
          "timerMin": null
        },
        {
          "text": "מרדדים את הבצק על משטח מקומח היטב לעלה בעובי 1 ס״מ וחותכים ריבועים של כ-5 ס״מ.",
          "timerMin": null
        },
        {
          "text": "שמים במרכז כל ריבוע משמש (מסונן היטב ממים) ומהדקים מעליו את הבצק לצרור קטן.",
          "timerMin": null
        },
        {
          "text": "מבשלים את הכופתאות בסיר גדול עם מי מלח רותחים, עד שהן צפות ועוד 5 דקות.",
          "timerMin": 5
        },
        {
          "text": "מוציאים מהמים עם כף מחוררת.",
          "timerMin": null
        },
        {
          "text": "ממיסים את שארית החמאה במחבת ומטגנים את פירורי הביסקוויטים והאגוזים עד לזהוב.",
          "timerMin": null
        },
        {
          "text": "מוסיפים את הכופתאות ומגלגלים אותן כדי שהפירורים יידבקו אליהן.",
          "timerMin": null
        },
        {
          "text": "מגישים עם צלוחית סוכר וקינמון, שכל סועד מוסיף לעצמו.",
          "timerMin": null
        }
      ]
    }
  ],
