  "steps": [
    {
      "group": "המילוי",
      "items": [
        {
          "text": "מאדים 3 מהבצלים בשמן תירס.",
          "timerMin": null
        },
        {
          "text": "קוצצים במג׳ימיקס את כל העלים עם בצל אחד, מוסיפים את הבשר, האורז והבצלים המאודים.",
          "timerMin": null
        },
        {
          "text": "מתבלים במלח ופלפל שחור גרוס לפי הטעם.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "הכנת העלים",
      "items": [
        {
          "text": "מסירים מ-4 הכרובים את הליבה ואת העלים החיצוניים.",
          "timerMin": null
        },
        {
          "text": "מפרידים את העלים: מבשלים כל כרוב בנפרד כ-10 דקות במיקרוגל, או חולטים במים רותחים עם מלח.",
          "timerMin": null
        },
        {
          "text": "מגלפים את הגבעול (מסירים את החלק הקשה בעלה).",
          "timerMin": null
        },
        {
          "text": "ממלאים כל עלה בכף מהמילוי ומגלגלים.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "המצע והאפייה",
      "items": [
        {
          "text": "מטגנים את הבצלים בשומן האווז עד שהם מזהיבים, מוסיפים את ליבות הכרוב פרוסות לרצועות דקות.",
          "timerMin": null
        },
        {
          "text": "מוסיפים את שני הכרובים החמוצים פרוסים לרצועות דקות ואת רכז העגבניות.",
          "timerMin": null
        },
        {
          "text": "מתבלים במעט מלח (בגלל הכרוב החמוץ), פלפל שחור גרוס גס, גרגרי ג׳וניפר, פלפל אנגלי, עלי דפנה ו-2 כפות סוכר.",
          "timerMin": null
        },
        {
          "text": "שופכים את המצע לגסטרונום, מסדרים מעליו את עלי הכרוב הממולאים, מפזרים מלח ופלפל ומוסיפים מעט מים ואת הנוזלים של הכרוב הכבוש, עד לגובה הכרוב.",
          "timerMin": null
        },
        {
          "text": "מכסים בנייר אפייה ומעליו בנייר אלומיניום.",
          "timerMin": null
        },
        {
          "text": "אופים ב-180 מעלות כשעה וחצי.",
          "timerMin": 90
        }
      ]
    },
    {
      "group": "ממליגה",
      "items": [
        {
          "text": "מביאים לרתיחה בסיר את החלב, המים, החמאה והמלח. כשהנוזל רותח, מנמיכים את האש ושופכים בזילוף דק את קמח התירס תוך בחישה מתמדת בכף עץ.",
          "timerMin": null
        },
        {
          "text": "בוחשים במרץ עד שהמסה נפרדת מדפנות הסיר, שופכים לגסטרונום ומשטחים.",
          "timerMin": null
        },
        {
          "text": "כשהממליגה מצטננת מעט ומתקשה, קורצים עיגולים בעזרת רינג.",
          "timerMin": null
        }
      ]
    }
  ],
  "tips": [
    "ממליגה מוגשת בעיגולים לצד הכרוב הממולא."
