  "steps": [
    {
      "group": "הכנת העיסה",
      "items": [
        {
          "text": "מאחדים את הבשרים הטחונים בקערה גדולה.",
          "timerMin": null
        },
        {
          "text": "מטגנים קלות את השאלוט והשום ב-50 גרם מהחמאה עד שמתרככים, ומוסיפים לבשר.",
          "timerMin": null
        },
        {
          "text": "באותה מחבת מטגנים בחמאה הנותרת את כבדי העוף, עד שהם מתקרשים אך עדיין ורודים בפנים. מניחים בצד לצינון.",
          "timerMin": null
        },
        {
          "text": "שופכים את הברנדי למחבת החמה ומרתיחים תוך קירצוף כל שאריות הטיגון. מצמצמים לכ-2 כפות, שופכים לעיסת הבשר, מערבבים ומניחים בצד.",
          "timerMin": null
        },
        {
          "text": "מוסיפים לעיסה שמנת, מיץ לימון, קמח, ביצה, מלח וכמות נדיבה של פלפל שחור, ואת קוביות הלשון, הפיסטוקים וגרגרי הפלפל הירוק.",
          "timerMin": null
        },
        {
          "text": "לשים את העיסה היטב, אפילו במקציף חשמלי, לטעום ולאזן תיבול.",
          "timerMin": null
        }
      ]
    },
    {
      "group": "הרכבה ואפייה",
      "items": [
        {
          "text": "מרפדים תבנית טרין בפיסות דקות של שומן אווז (או בניילון נצמד), כך שהפיסות חופפות זו את זו ונשאר אורך לכיסוי העליון.",
          "timerMin": null
        },
        {
          "text": "שופכים מחצית מהעיסה לתבנית ומהדקים היטב.",
          "timerMin": null
        },
        {
          "text": "חותכים את כבדי העוף לרבעים או לשמיניות, לפי הגודל, ומשקיעים במרכז העיסה.",
          "timerMin": null
        },
        {
          "text": "מכסים ביתרת העיסה, מהדקים ומחליקים היטב, מניחים מעל עלי דפנה ומכסים בנייר אפייה.",
          "timerMin": null
        },
        {
          "text": "אופים שעתיים בתנור בחום 175 מעלות (350°F), בתוך תבנית מלאה במים רותחים שמגיעים עד מחצית גובה כלי האפייה. הטרין מוכן כשהנוזלים שמצטברים למעלה שקופים.",
          "timerMin": 120
        }
      ]
    },
    {
      "group": "צינון",
      "items": [
        {
          "text": "מחליפים את כיסוי רדיד האלומיניום בחדש, מניחים משקולת ומצננים בחום החדר.",
          "timerMin": null
        },
        {
          "text": "מכניסים למקרר כשהמשקולת עדיין מעל, ומצננים עד לקרישה מלאה.",
          "timerMin": null
        }
      ]
    }
  ],
  "tips": [
    "נהוג לפרוס ולהגיש את הטרין בתוך כלי האפייה."
