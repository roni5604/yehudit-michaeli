  "steps": [
    {
      "group": null,
      "items": [
        {
          "text": "מפרידים את הברוקולי לפרחים. מנקים את השעועית, מסירים סיבים לפי הצורך וחותכים כל תרמיל לשניים.",
          "timerMin": null
        },
        {
          "text": "בסיר גדול על להבה בינונית-נמוכה מחממים שמן זית עם השום והריחן כדקה, בלי לתת לשום להשחים.",
          "timerMin": null
        },
        {
          "text": "מוסיפים את ציר הירקות, הברוקולי והשעועית, מתבלים במלח ופלפל ומבשלים 5 עד 6 דקות. מניחים בצד.",
          "timerMin": 5
        },
        {
          "text": "מרתיחים בסיר גדול כ-5 ליטר מים עם כף מלח ומבשלים את הפסטה אל דנטה.",
          "timerMin": null
        },
        {
          "text": "בעוד הפסטה מתבשלת, מחזירים את סיר הירקות לאש ומביאים לסף רתיחה.",
          "timerMin": null
        },
        {
          "text": "מסננים את הפסטה ומפזרים עליה מחצית מהפרמזן. מערבבים עם הירקות, מפזרים את שאר הגבינה ומגישים.",
          "timerMin": null
        }
      ]
    }
  ],
