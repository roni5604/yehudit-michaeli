  "steps": [
    { "group": "הבצק", "items": [
      { "text": "מעבדים במעבד מזון עם להב פלדה את הקמח, החמאה והמלח, עד לתערובת פירורית.", "timerMin": null },
      { "text": "מוסיפים את הביצה ומעבדים עד שנוצר בצק. אם הוא לא מתגבש לגושים גדולים, מוסיפים כף או שתיים של מים וממשיכים לעבד.", "timerMin": null },
      { "text": "מאחדים את גושי הבצק לדיסקית, עוטפים בניילון נצמד ומקררים כחצי שעה.", "timerMin": 30 },
      { "text": "מרדדים את הבצק לעיגול בעובי כ-3 מ״מ ומרפדים את התבנית או הטבעת. מקפידים על זווית ישרה בין הדפנות לתחתית, כדי שהשוליים יישארו גבוהים.", "timerMin": null },
      { "text": "דוקרים את התחתית במזלג ומקפיאים כחצי שעה.", "timerMin": 30 }
    ] },
    { "group": "המלית", "items": [
      { "text": "מחממים מעט שמן זית במחבת רחבה ומקפיצים את הברוקולי על להבה גבוהה, עד שהוא מתרכך מעט ומתחמם.", "timerMin": null },
      { "text": "מתבלים במלח ופלפל, מעבירים לקערה ומצננים. מוסיפים את עגבניות השרי.", "timerMin": null }
    ] },
    { "group": "הרויאל וההרכבה", "items": [
      { "text": "בקערה קטנה טורפים את השמנת, הביצים, המלח, הפלפל, הקמח ואגוז המוסקט לבלילה אחידה. מוסיפים את הפטה ומערבבים היטב.", "timerMin": null },
      { "text": "מחממים את התנור ל-170 מעלות.", "timerMin": null },
      { "text": "מפזרים את הברוקולי ואת עגבניות השרי על הבצק הקפוא, ויוצקים מעליהם את הרויאל.", "timerMin": null },
      { "text": "אופים 35-45 דקות, עד שהמלית מתייצבת והבצק מזהיב.", "timerMin": 35 },
      { "text": "מצננים בטמפרטורת החדר ומגישים.", "timerMin": null }
    ] }
