---
// Inlines the brand SVGs, re-coloured through CSS variables so they follow light/dark/high-contrast themes.
import markRaw from "../../public/brand/logo-mark.svg?raw";
import wordRaw from "../../public/brand/logo-wordmark.svg?raw";
interface Props { variant?: "lockup" | "mark" | "word"; class?: string; size?: number }
const { variant = "lockup", class: cls, size = 52 } = Astro.props;
const themed = (svg: string) =>
  svg
    .replaceAll("#6B1E2B", "var(--logo-main, var(--bordeaux))")
    .replaceAll("#B4693E", "var(--logo-accent, var(--copper))")
    .replaceAll("#F6EFE4", "var(--logo-bg, var(--paper))")
    .replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true" focusable="false"')
    .replace(/ width="\d+" height="\d+"/, "");
const mark = themed(markRaw);
const word = themed(wordRaw);
---
<span class:list={["logo", cls]} style={`--logo-size:${size}px`}>
  {variant !== "word" && <span class="logo-mark" set:html={mark} />}
  {variant !== "mark" && <span class="logo-word" set:html={word} />}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--bordeaux); }
  .logo-mark { display: block; width: var(--logo-size); height: var(--logo-size); flex: none; }
  .logo-mark :global(svg) { width: 100%; height: 100%; display: block; }
  .logo-word { display: block; height: calc(var(--logo-size) * 0.86); }
  .logo-word :global(svg) { height: 100%; width: auto; display: block; }
  :global(html.a11y-contrast) .logo { --logo-main: var(--ink); --logo-accent: var(--ink); }
</style>
