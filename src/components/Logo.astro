---
// The original Michaeli restaurant logo (handwritten "מיכאלי" + leaf, "מטבח כפרי").
// Light/dark versions swap with the site theme; "mark" is the leaf alone.
interface Props { variant?: "lockup" | "mark" | "word"; class?: string; size?: number; tone?: "auto" | "light" | "dark" }
const { variant = "lockup", class: cls, size = 52, tone = "auto" } = Astro.props;
const h = variant === "mark" ? size : Math.round(size * 0.95);
---
{variant === "mark" ? (
  <img class:list={["logo-mark-img", cls]} src="/brand/michaeli-mark.png" alt="" width={size} height={size} style={`width:${size}px;height:${size}px`} />
) : (
  <span class:list={["mlogo", `tone-${tone}`, cls]} style={`--h:${h}px`}>
    <img class="ml-light" src="/brand/michaeli-logo.webp" alt="מיכאלי – מטבח כפרי" width="1312" height="369" />
    <img class="ml-dark" src="/brand/michaeli-logo-dark.webp" alt="" aria-hidden="true" width="1312" height="369" />
  </span>
)}
<style>
  .mlogo { display: inline-block; height: var(--h); }
  .mlogo img { height: 100%; width: auto; display: block; }
  .ml-dark { display: none !important; }
  .tone-dark .ml-light { display: none !important; }
  .tone-dark .ml-dark { display: block !important; }
  :global(:root[data-theme="dark"]) .tone-auto .ml-light { display: none !important; }
  :global(:root[data-theme="dark"]) .tone-auto .ml-dark { display: block !important; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .tone-auto .ml-light { display: none !important; }
    :global(:root:not([data-theme="light"])) .tone-auto .ml-dark { display: block !important; }
  }
  .logo-mark-img { display: block; border-radius: 50%; }
</style>
