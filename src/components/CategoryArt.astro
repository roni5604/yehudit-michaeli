---
// Illustrated fallback for recipes without a photo, and category tiles.
import { art, toneFor } from "../lib/art";
interface Props { icon: string; title?: string; seed?: string; class?: string; label?: string }
const { icon, seed = icon, class: cls, label } = Astro.props;
const [bg, fg, h] = toneFor(seed);
const id = `p${h.toString(36)}`;
---
<svg class:list={["category-art", cls]} viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"}>
  <defs>
    <pattern id={id} width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
      <path d="M0 5h10" stroke={fg} stroke-opacity=".07" stroke-width="1.2" />
    </pattern>
  </defs>
  <rect width="300" height="200" fill={bg} />
  <rect width="300" height="200" fill={`url(#${id})`} />
  <circle cx="150" cy="100" r="74" fill="none" stroke={fg} stroke-opacity=".18" stroke-width="1.2" />
  <circle cx="150" cy="100" r="68" fill="none" stroke={fg} stroke-opacity=".12" stroke-width=".8" />
  <g transform="translate(102 52) scale(1.2)" fill="none" stroke={fg} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={art[icon] ?? art.plate} />
</svg>
<style>
  .category-art { display: block; width: 100%; height: 100%; }
  :global(:root[data-theme="dark"]) .category-art { filter: brightness(.82) saturate(.9); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .category-art { filter: brightness(.82) saturate(.9); } }
</style>
