---
import Logo from "./Logo.astro";
import { SITE, NAV, LEGAL } from "../lib/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-x grid">
    <div class="about">
      <Logo variant="mark" size={84} />
      <p class="tag">
        מתכונים, תפריטים וזיכרונות מהמטבח של <strong>השפית יהודית מיכאלי</strong>,
        ממסעדת <span class="nowrap">״מיכאלי – מטבח כפרי״</span> ברשפון.
      </p>
      <p class="latin small">Cuisine de campagne · Rishpon</p>
    </div>
    <nav aria-label="ניווט באתר">
      <h2 class="h">באתר</h2>
      <ul>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/holidays">חגים ומועדים</a></li>
        <li><a href="/cuisines">מטבחי העולם</a></li>
      </ul>
    </nav>
    <nav aria-label="מידע משפטי ונגישות">
      <h2 class="h">מידע ונגישות</h2>
      <ul>
        {LEGAL.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><button type="button" class="linklike" data-open-consent>ניהול העדפות עוגיות</button></li>
        <li><button type="button" class="linklike" data-open-a11y>תפריט נגישות</button></li>
      </ul>
    </nav>
    <div>
      <h2 class="h">שימושי במטבח</h2>
      <ul>
        <li><a href="/favorites">המועדפים שלי</a></li>
        <li><a href="/shopping-list">רשימת הקניות</a></li>
        <li><a href="/kitchen#converter">ממיר מידות</a></li>
        <li><a href="/recipes?surprise=1" data-surprise>הפתיעי אותי</a></li>
      </ul>
    </div>
  </div>
  <div class="container-x base">
    <p>© {year} משפחת מיכאלי. כל הזכויות על התכנים שמורות. <a href={SITE.repo} rel="noopener">קוד המקור</a> ברישיון MIT.</p>
    <p>נבנה באהבה, לכבודה של השפית יהודית מיכאלי, על ידי המשפחה. <a href="/credits">קרדיטים</a></p>
  </div>
</footer>
<style>
  .site-footer { margin-top: clamp(64px, 10vw, 140px); background: var(--paper-2); border-top: 1px solid var(--line); padding-block: 56px 28px; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 36px; }
  .about { display: grid; gap: 14px; align-content: start; }
  .tag { color: var(--ink-soft); max-width: 36ch; margin: 0; }
  .small { color: var(--ink-mute); margin: 0; }
  .h { font-family: var(--font-body); font-size: 0.95rem; letter-spacing: .12em; color: var(--copper-text); margin: 6px 0 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  a, .linklike { color: var(--ink); text-decoration: none; font-weight: 500; }
  a:hover, .linklike:hover { color: var(--bordeaux); text-decoration: underline; }
  .linklike { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-align: start; }
  li { min-height: 32px; display: flex; align-items: center; }
  .base { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--ink-mute); font-size: var(--step--1); }
  .base p { margin: 0; }
  .base a { color: var(--ink-soft); text-decoration: underline; }
  .nowrap { white-space: nowrap; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
