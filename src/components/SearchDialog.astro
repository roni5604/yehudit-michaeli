---
import Icon from "./Icon.astro";
---
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="inner">
    <h2 id="search-title" class="visually-hidden">חיפוש מתכונים</h2>
    <div class="bar">
      <Icon name="search" size={24} />
      <input
        id="search-input" class="q" type="search" autocomplete="off" spellcheck="false"
        placeholder="מה מבשלים היום? (למשל: עוגת גבינה, חציל, אזני המן)"
        role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list"
        aria-label="חיפוש מתכונים לפי שם, מצרך או תגית"
      />
      <button class="icon-btn" type="button" data-close-search aria-label="סגירת החיפוש"><Icon name="close" /></button>
    </div>
    <p class="status" id="search-status" role="status" aria-live="polite"></p>
    <ul id="search-results" class="results" role="listbox" aria-label="תוצאות החיפוש"></ul>
    <p class="hint">✦ מתכון מלא באתר · ↗ נפתח במחברת המקורית בדרייב. <kbd>Enter</kbd> לפתיחה, <kbd>Esc</kbd> לסגירה.</p>
  </div>
</dialog>

<script>
  import MiniSearch from "minisearch";
  import { variants, tokenize } from "../lib/hebrew";

  type Doc = { id: string; t: string; d: string; c: string; i: string; g: string; href: string; ext: number };
  let ms: MiniSearch<Doc> | null = null;
  let loading: Promise<void> | null = null;
  let active = -1;

  function load() {
    if (loading) return loading;
    loading = fetch("/search-index.json")
      .then((r) => r.json())
      .then((docs: Doc[]) => {
        ms = new MiniSearch<Doc>({
          fields: ["t", "i", "g", "c", "d"],
          storeFields: ["t", "c", "href", "ext"],
          tokenize,
          processTerm: (term) => variants(term),
          searchOptions: { boost: { t: 5, g: 2, i: 1.6, c: 1.2 }, prefix: (term) => term.length > 2, fuzzy: (term) => (term.length > 4 ? 0.18 : false), combineWith: "AND" },
        });
        ms.addAll(docs);
      });
    return loading;
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  function render(q: string) {
    const list = document.getElementById("search-results")!;
    const input = document.getElementById("search-input") as HTMLInputElement;
    const status = document.getElementById("search-status")!;
    active = -1;
    input.removeAttribute("aria-activedescendant");
    if (!ms || q.trim().length < 2) {
      list.innerHTML = "";
      input.setAttribute("aria-expanded", "false");
      status.textContent = q.trim().length ? "הקלידו לפחות שתי אותיות" : "";
      return;
    }
    let res = ms.search(q);
    if (!res.length) res = ms.search(q, { combineWith: "OR" });
    const top = res.slice(0, 40);
    status.textContent = res.length ? `נמצאו ${res.length} מתכונים${res.length > 40 ? " (מוצגים 40 הראשונים)" : ""}` : "לא נמצאו מתכונים. נסו מילה אחרת.";
    list.innerHTML = top
      .map((r, n) => `<li role="option" id="sr-${n}" aria-selected="false"><a href="${esc(r.href)}" tabindex="-1"${r.ext ? ' target="_blank" rel="noopener"' : ""}><strong>${esc(r.t)}</strong><span>${esc(r.c)}${r.ext ? " ↗" : " ✦"}</span></a></li>`)
      .join("");
    input.setAttribute("aria-expanded", String(top.length > 0));
  }

  function move(delta: number) {
    const items = [...document.querySelectorAll<HTMLLIElement>("#search-results [role=option]")];
    if (!items.length) return;
    active = (active + delta + items.length) % items.length;
    items.forEach((li, i) => li.setAttribute("aria-selected", String(i === active)));
    const input = document.getElementById("search-input") as HTMLInputElement;
    input.setAttribute("aria-activedescendant", items[active].id);
    items[active].scrollIntoView({ block: "nearest" });
  }

  function open(prefill = "") {
    const dlg = document.getElementById("search-dialog") as HTMLDialogElement;
    const input = document.getElementById("search-input") as HTMLInputElement;
    if (!dlg.open) dlg.showModal();
    if (prefill) input.value = prefill;
    input.focus();
    input.select();
    load().then(() => render(input.value));
  }

  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("[data-open-search]")) { e.preventDefault(); open(); }
    if (t.closest("[data-close-search]")) (document.getElementById("search-dialog") as HTMLDialogElement).close();
    if (t.id === "search-dialog") (t as HTMLDialogElement).close();
  });
  document.addEventListener("input", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.id === "search-input") load().then(() => render(t.value));
  });
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    const typing = t.matches("input, textarea, select, [contenteditable]");
    if ((e.key === "/" && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")) { e.preventDefault(); open(); return; }
    if (t.id !== "search-input") return;
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Enter") {
      const sel = document.querySelector<HTMLAnchorElement>(`#sr-${Math.max(active, 0)} a`);
      if (sel) { e.preventDefault(); (document.getElementById("search-dialog") as HTMLDialogElement).close(); sel.click(); }
    }
  });
  document.addEventListener("ym:search", (e) => open((e as CustomEvent).detail || ""));
</script>

<style>
  .search-dialog { width: min(720px, calc(100vw - 20px)); margin-top: 8vh; max-height: 80vh; }
  .inner { display: grid; gap: 8px; padding: 14px 16px 16px; }
  .bar { display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 10px; color: var(--ink-mute); }
  .q { flex: 1; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 1.3rem; min-height: 52px; outline: none; }
  .q:focus-visible { outline: none; }
  .bar:focus-within { border-bottom-color: var(--bordeaux); }
  .status { margin: 4px 2px; color: var(--ink-mute); font-size: .92rem; min-height: 1.4em; }
  .results { list-style: none; margin: 0; padding: 0; overflow: auto; max-height: 52vh; display: grid; gap: 2px; }
  .results :global(a) { display: flex; justify-content: space-between; gap: 14px; padding: 12px 14px; border-radius: 12px; color: var(--ink); text-decoration: none; }
  .results :global(a span) { color: var(--ink-mute); font-size: .92rem; white-space: nowrap; }
  .results :global(a:hover), .results :global([aria-selected="true"] a) { background: color-mix(in oklab, var(--bordeaux) 10%, var(--card)); }
  .results :global([aria-selected="true"] a) { outline: 2px solid var(--bordeaux); }
  .hint { margin: 6px 2px 0; color: var(--ink-mute); font-size: .85rem; }
  kbd { font-family: inherit; font-size: .8rem; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 0 6px; background: var(--card); }
</style>
