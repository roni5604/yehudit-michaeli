---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CategoryTile from "../../components/CategoryTile.astro";
import { catalog, coverFor } from "../../lib/data";
import { holidays } from "../../lib/site";
const counts = new Map<string, number>(); for (const e of catalog) if (e.h) counts.set(e.h, (counts.get(e.h) ?? 0) + 1);
const icons: Record<string, string> = { "rosh-hashana": "jam", hanukkah: "croissant", "tu-bishvat": "olive", purim: "cookie", passover: "bread", shavuot: "cheese", shabbat: "bread" };
const list = holidays.filter((h) => counts.get(h.slug));
const cover = (_: string) => null;
---
<BaseLayout title="חגים ומועדים" description="מתכונים לחגי ישראל מהמטבח של יהודית מיכאלי: ראש השנה, חנוכה, ט״ו בשבט, פורים, פסח, שבועות ושבת.">
  <div class="container-x head">
    <Breadcrumbs items={[{ label: "חגים ומועדים" }]} />
    <h1>חגים ומועדים</h1>
    <p class="lede">לכל חג יש טעם משלו: סופגניות ולביבות בחנוכה, אוזני המן בפורים, עוגות גבינה בשבועות.</p>
  </div>
  <section class="container-x tiles">
    {list.map((h) => <CategoryTile href={`/holidays/${h.slug}`} title={h.he} count={counts.get(h.slug) ?? 0} icon={icons[h.slug] ?? "plate"} cover={coverFor("hol", h.slug)} headingLevel={2} />)}
  </section>
</BaseLayout>
<style>
  .head { padding-block: 24px 28px; } .head h1 { margin: 10px 0 6px; }
  .tiles { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); }
</style>
