---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RecipeImage from "../../components/RecipeImage.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import Icon from "../../components/Icon.astro";
import RecipeInteractive from "../../islands/RecipeInteractive.tsx";
import { getRecipes, related, imageFor, categoryLabel, subLabel, holidayLabel, cuisineLabel, kashrutLabel, type Recipe } from "../../lib/data";
import { SITE, formatMinutes, isoDuration, difficultyLabel, dietBySlug, catBySlug } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getRecipes();
  return all.map((r) => ({ params: { slug: r.slug }, props: { recipe: r } }));
}
const { recipe: r } = Astro.props as { recipe: Recipe };
const all = await getRecipes();
const rel = related(r, all, 6);
const img = imageFor(r.slug);
const sub = subLabel(r);
const cat = catBySlug[r.category];

const crumbs = [
  { href: "/recipes", label: "מתכונים" },
  { href: `/categories/${r.category}`, label: categoryLabel(r) },
  ...(r.subcategory && sub ? [{ href: `/categories/${r.category}/${r.subcategory}`, label: sub }] : []),
  { label: r.title },
];

const sourceLine = (() => {
  const s = r.source;
  if (s.type === "family") return "מהמטבח של יהודית מיכאלי";
  if (s.type === "restaurant") return "מנה מהמטבח של מסעדת מיכאלי, רשפון";
  if (s.type === "course") return "מתוך מחברות קורס הבישול והקונדיטוריה של יהודית";
  if (s.type === "friend") return s.credit ? `המתכון של ${s.credit}, מהמחברת של יהודית` : "מתכון של חברה, מהמחברת של יהודית";
  if (s.credit) return s.rewritten ? `בהשראת מתכון של ${s.credit}. אופן ההכנה נכתב מחדש.` : `באדיבות ${s.credit}`;
  return "מהאוסף של יהודית מיכאלי";
})();

const ld = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: r.title,
  alternateName: r.titleEn,
  description: r.description,
  inLanguage: "he",
  author: { "@type": "Person", name: s(r) },
  image: img ? [new URL(img.src1280, SITE.url).href] : undefined,
  recipeCategory: categoryLabel(r),
  recipeCuisine: cuisineLabel(r.cuisine) ?? undefined,
  keywords: [...r.tags, ...r.holidays.map(holidayLabel)].join(", ") || undefined,
  recipeYield: r.servings ? `${r.servings} מנות` : r.yield ?? undefined,
  prepTime: isoDuration(r.prepMin),
  cookTime: isoDuration(r.cookMin),
  totalTime: isoDuration(r.totalMin),
  suitableForDiet: r.diet.includes("vegan") ? "https://schema.org/VeganDiet" : r.diet.includes("vegetarian") ? "https://schema.org/VegetarianDiet" : r.diet.includes("gluten-free") ? "https://schema.org/GlutenFreeDiet" : undefined,
  recipeIngredient: r.ingredients.flatMap((g) => g.items.map((i) => i.raw)),
  recipeInstructions: r.steps.flatMap((g) => g.items.map((st) => ({ "@type": "HowToStep", text: st.text }))),
};
function s(rec: Recipe) {
  return rec.source.type === "chef" || rec.source.type === "book" ? rec.source.credit ?? "יהודית מיכאלי" : "יהודית מיכאלי";
}
const meta = [
  r.prepMin ? { icon: "clock", k: "הכנה", v: formatMinutes(r.prepMin) } : null,
  r.cookMin ? { icon: "flame", k: "בישול/אפייה", v: formatMinutes(r.cookMin) } : null,
  r.totalMin ? { icon: "timer", k: "סה״כ", v: formatMinutes(r.totalMin) } : null,
  r.servings ? { icon: "users", k: "מנות", v: String(r.servings) } : r.yield ? { icon: "users", k: "כמות", v: r.yield } : null,
  { icon: "chef", k: "רמת קושי", v: difficultyLabel[r.difficulty] },
].filter(Boolean) as { icon: any; k: string; v: string }[];
---
<BaseLayout
  title={r.title}
  description={r.description}
  image={img?.og ?? "/og-default.jpg"}
  imageAlt={r.alt}
  type="article"
  jsonld={ld}
>
  <article class="recipe container-x" data-recipe={r.slug}>
    <div class="top"><Breadcrumbs items={crumbs} /></div>

    <header class="hero">
      <div class="hero-text">
        <p class="eyebrow">{categoryLabel(r)}{sub ? ` · ${sub}` : ""}</p>
        <h1>{r.title}</h1>
        <p class="lede">{r.description}</p>
        <ul class="chips" aria-label="תגיות">
          {r.kashrut && <li class={`chip chip-${r.kashrut}`}>{kashrutLabel(r.kashrut)}</li>}
          {r.cuisine && <li><a class="chip chip-accent" href={`/cuisines/${r.cuisine}`}>מטבח {cuisineLabel(r.cuisine)}</a></li>}
          {r.holidays.map((h) => <li><a class="chip chip-accent" href={`/holidays/${h}`}>{holidayLabel(h)}</a></li>)}
          {r.diet.map((d) => <li class="chip">{dietBySlug[d]?.he}</li>)}
        </ul>
        <dl class="meta">
          {meta.map((m) => (
            <div><dt><Icon name={m.icon} size={18} /> {m.k}</dt><dd>{m.v}</dd></div>
          ))}
        </dl>
        {r.timesEstimated && (r.prepMin || r.totalMin) ? <p class="est">* הזמנים משוערים</p> : null}
        {r.pan && <p class="pan"><strong>כלי:</strong> {r.pan}</p>}
        <div class="actions no-print">
          <button type="button" class="btn btn-ghost btn-sm fav-big" data-fav={r.slug} data-title={r.title} aria-pressed="false">
            <Icon name="heart" size={18} /> <span class="off">שמירה למועדפים</span><span class="on">שמור במועדפים</span>
          </button>
          <button type="button" class="btn btn-ghost btn-sm" data-print><Icon name="print" size={18} /> הדפסה</button>
          <button type="button" class="btn btn-ghost btn-sm" data-share data-title={r.title}><Icon name="share" size={18} /> שיתוף</button>
          <a class="btn btn-ghost btn-sm" href={`https://wa.me/?text=${encodeURIComponent(`${r.title} — ${SITE.url}/recipes/${r.slug}`)}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> וואטסאפ<span class="visually-hidden"> (נפתח בחלון חדש)</span></a>
        </div>
      </div>
      <div class="hero-media recipe-hero-media">
        <RecipeImage slug={r.slug} category={r.category} alt={r.alt} eager sizes="(max-width: 900px) 100vw, 640px" transitionName={`img-${r.slug}`} />
      </div>
    </header>

    {r.story && (
      <blockquote class="story">
        <p>{r.story}</p>
        <footer>יהודית</footer>
      </blockquote>
    )}

    <div class="body recipe-layout">
      <RecipeInteractive client:idle slug={r.slug} title={r.title} servings={r.servings} yieldText={r.yield} ingredients={r.ingredients} steps={r.steps} />
    </div>

    {r.tips.length > 0 && (
      <aside class="tips" aria-labelledby="tips-title">
        <h2 id="tips-title">טיפים מהמטבח</h2>
        <ul>{r.tips.map((t) => <li>{t}</li>)}</ul>
      </aside>
    )}

    <p class="source"><Icon name="book" size={18} /> {sourceLine}</p>
    {r.tags.length > 0 && (
      <p class="tags no-print">{r.tags.map((t) => <span class="chip">#{t}</span>)}</p>
    )}
    <p class="print-only">{SITE.url}/recipes/{r.slug}</p>
  </article>

  {rel.length > 0 && (
    <section class="container-x related no-print" aria-labelledby="rel-title">
      <div class="rule-ornament" aria-hidden="true">✦</div>
      <h2 id="rel-title">עוד מאותו מטבח</h2>
      <div class="grid-cards">
        {rel.map((o) => <RecipeCard recipe={o} />)}
      </div>
      <p class="more"><a class="btn btn-ghost" href={`/categories/${r.category}`}>לכל ה{cat?.he}</a></p>
    </section>
  )}
</BaseLayout>

<script>
  function init() {
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
    const sb = document.querySelector<HTMLButtonElement>("[data-share]");
    sb?.addEventListener("click", async () => {
      const data = { title: sb.dataset.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else { await navigator.clipboard.writeText(location.href); sb.lastChild!.textContent = " הקישור הועתק ✓"; }
      } catch { /* user cancelled */ }
    });
  }
  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .top { padding-top: 22px; }
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(24px, 4vw, 60px); align-items: center; padding-block: 26px 40px; }
  .hero h1 { margin: 6px 0 14px; }
  .hero .lede { margin: 0 0 18px; }
  .hero-media { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4 / 3; box-shadow: 0 40px 70px -40px rgb(var(--shadow) / .6); background: var(--paper-3); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0 0 18px; }
  .chips a { text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0 0 6px; padding: 16px 0; border-block: 1px solid var(--line); }
  .meta dt { display: flex; align-items: center; gap: 6px; font-size: .88rem; color: var(--ink-mute); }
  .meta dd { margin: 2px 0 0; font-weight: 700; font-size: 1.1rem; }
  .est { margin: 4px 0 0; color: var(--ink-mute); font-size: .85rem; }
  .pan { margin: 10px 0 0; color: var(--ink-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .fav-big .on { display: none; }
  .fav-big[aria-pressed="true"] { background: var(--bordeaux); color: var(--paper); }
  .fav-big[aria-pressed="true"] .on { display: inline; }
  .fav-big[aria-pressed="true"] .off { display: none; }
  .fav-big[aria-pressed="true"] :global(svg) { fill: currentColor; }
  .story { margin: 0 auto 40px; max-width: 760px; padding: 26px 30px; background: var(--paper-2); border-inline-start: 4px solid var(--copper); border-radius: 0 var(--radius) var(--radius) 0; font-family: var(--font-display); font-size: var(--step-1); }
  .story p { margin: 0; }
  .story footer { margin-top: 10px; font-family: var(--font-latin); font-style: italic; color: var(--copper-text); }
  .body { padding-block: 10px 40px; }
  .tips { margin: 10px 0 30px; padding: 24px 28px; background: color-mix(in oklab, var(--olive) 9%, var(--card)); border: 1px solid color-mix(in oklab, var(--olive) 30%, var(--line)); border-radius: var(--radius-lg); }
  .tips h2 { font-size: var(--step-1); margin: 0 0 10px; }
  .tips ul { margin: 0; padding-inline-start: 1.2em; display: grid; gap: 8px; }
  .source { display: flex; gap: 8px; align-items: center; color: var(--ink-soft); font-style: italic; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .related { padding-top: 40px; }
  .related h2 { text-align: center; margin: 18px 0 30px; }
  .more { text-align: center; margin-top: 30px; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-media { order: -1; }
  }
</style>
