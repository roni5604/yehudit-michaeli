---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RecipeBrowser from "../../islands/RecipeBrowser.tsx";
import { catalog, countBy } from "../../lib/data";
import { categories, cuisines, holidays } from "../../lib/site";

const cnt = (key: "c" | "sc" | "h" | "cu") => { const m = new Map<string, number>(); for (const e of catalog) { const v = e[key]; if (v) m.set(v, (m.get(v) ?? 0) + 1); } return m; };
const cc = cnt("c"), sc = cnt("sc"), hc = cnt("h"), cuc = cnt("cu");
const props = {
  total: catalog.length,
  categories: categories.filter((c) => cc.get(c.slug)).map((c) => ({ slug: c.slug, he: c.he, count: cc.get(c.slug) })),
  subs: Object.fromEntries(categories.map((c) => [c.slug, c.subs.filter((s) => sc.get(s.slug)).map((s) => ({ slug: s.slug, he: s.he, count: sc.get(s.slug) }))])),
  holidays: holidays.filter((h) => hc.get(h.slug)).map((h) => ({ slug: h.slug, he: h.he, count: hc.get(h.slug) })),
  cuisines: cuisines.filter((c) => cuc.get(c.slug)).map((c) => ({ slug: c.slug, he: c.he, count: cuc.get(c.slug) })),
};
---
<BaseLayout title="כל המתכונים" description={`כל ${catalog.length.toLocaleString("he-IL")} המתכונים מהמחברות של יהודית מיכאלי, מסודרים לפי קטגוריות, חגים ומטבחים.`}>
  <div class="container-x head">
    <Breadcrumbs items={[{ label: "כל המתכונים" }]} />
    <h1>כל המתכונים</h1>
    <p class="lede">{catalog.length.toLocaleString("he-IL")} מתכונים מהמחברות של יהודית. מתכונים מסומנים ב-✦ פתוחים כאן במלואם; כל השאר נפתחים במחברת המקורית שלה בגוגל דרייב. <a href="/recipes?surprise=1">הפתיעי אותי</a> · <a href="/recipes/a-z">אינדקס א–ת</a></p>
  </div>
  <section class="container-x" aria-label="קטלוג המתכונים">
    <RecipeBrowser client:load {...props} />
  </section>
</BaseLayout>
<style>
  .head { padding-block: 24px 20px; } .head h1 { margin: 10px 0 8px; } .lede { max-width: 75ch; margin: 0; }
</style>
