---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
interface Props { title: string; description: string; updated?: string }
const { title, description, updated } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="container-narrow prose-page">
    <Breadcrumbs items={[{ label: title }]} />
    <h1>{title}</h1>
    {updated && <p class="updated">עדכון אחרון: {new Date(updated).toLocaleDateString("he-IL", { day: "numeric", month: "long", year: "numeric" })}</p>}
    <div class="prose"><slot /></div>
  </div>
</BaseLayout>
<style>
  .prose-page { padding-block: 24px 40px; }
  .prose-page h1 { font-size: var(--step-3); margin: 14px 0 6px; }
  .updated { color: var(--ink-mute); margin: 0 0 26px; }
  .prose :global(h2) { font-size: var(--step-1); margin: 34px 0 10px; color: var(--bordeaux); }
  .prose :global(p), .prose :global(li) { color: var(--ink-soft); }
  .prose :global(ul) { padding-inline-start: 1.3em; display: grid; gap: 6px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: .95rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--line); padding: 10px 12px; text-align: start; vertical-align: top; }
  .prose :global(th) { background: var(--paper-2); }
  .prose :global(code) { font-size: .9em; background: var(--paper-2); padding: 1px 6px; border-radius: 6px; direction: ltr; unicode-bidi: isolate; }
  .prose :global(.box) { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin: 18px 0; }
</style>
